---
import '../styles/global.css';
import { clinic } from '../config/clinic';
import DemoRibbon from '../components/DemoRibbon.astro';

interface Props {
  title?: string;
  description?: string;
}
const { title = clinic.seo.title, description = clinic.seo.description } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogImage = Astro.site ? new URL('/photos/hero.jpg', Astro.site) : undefined;
---

<!doctype html>
<html lang="bg">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="3840" />
          <meta property="og:image:height" content="2560" />
          <meta property="og:image:alt" content={`Демонстрационен сайт на ${clinic.name}`} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />

    <!-- Pre-paint motion guard: hides intro elements before the motion island
         boots. It recovers after 3s so content can never be stuck hidden. -->
    <script is:inline>
      (function () {
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          var d = document.documentElement;
          d.classList.add('motion-pending');
          setTimeout(function () {
            d.classList.remove('motion-pending');
          }, 3000);
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Към основното съдържание</a>
    <DemoRibbon />
    <slot />
    <script>
      import '../scripts/motion';
    </script>
    <!-- AutoSilas chat assistant -->
    <script src="https://widget.boyanbudakov.com/w.js" data-client="iris" is:inline defer></script>
  </body>
</html>
