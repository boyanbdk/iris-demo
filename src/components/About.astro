---
import { clinic } from '../config/clinic';

const leadDoctor = clinic.doctors.find((doctor) => doctor.lead);
if (!leadDoctor) throw new Error('Iris requires one lead doctor');

const points = [
  'Внимателно отношение и време за въпросите на пациента',
  'Ясно обяснение на предложените стъпки и възможности',
  'Съвременна среда и индивидуален план за грижа',
  'Спокоен подход към възрастни и деца',
];
---

<section class="section about" id="about">
  <div class="wrap about__grid">
    <figure class="about__visual reveal reveal-scale">
      <img
        class="about__photo"
        src={leadDoctor.image}
        alt={leadDoctor.imageAlt}
        width="1200"
        height="1500"
        loading="lazy"
      />
      <figcaption>
        <strong>{leadDoctor.name}</strong>
        <span>{leadDoctor.specialty}</span>
      </figcaption>
    </figure>

    <div class="about__copy reveal">
      <span class="eyebrow">За клиниката</span>
      <h2>Стоматология, на която можете да се доверите</h2>
      <p>
        В <strong>{clinic.name}</strong> вярваме, че посещението при зъболекар не трябва да плаши.
        {leadDoctor.name} и екипът посрещат всеки пациент със спокойствие, търпение и внимание —
        от първия преглед до крайния резултат.
      </p>
      <p>{leadDoctor.bio}</p>
      <ul class="about__list">
        {
          points.map((p) => (
            <li>
              <span class="tick" aria-hidden="true">
                ✓
              </span>
              {p}
            </li>
          ))
        }
      </ul>
      <a class="btn btn--primary" href="#contact">Поискайте час</a>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--bg-deep);
  }
  .about__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .about__grid {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }
  .about__visual {
    position: relative;
    max-width: 520px;
  }
  .about__photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: 620px;
    object-fit: cover;
    object-position: center top;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
  }
  .about__visual figcaption {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    display: grid;
    gap: 0.1rem;
    padding: 0.9rem 1rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 253, 248, 0.92);
    backdrop-filter: blur(10px);
  }
  .about__visual figcaption span {
    color: var(--ink-soft);
    font-size: 0.86rem;
  }
  .about__copy h2 {
    font-size: clamp(2rem, 4.2vw, 3rem);
    margin-top: 0.9rem;
  }
  .about__copy > p {
    margin-top: 1.2rem;
    color: var(--ink-soft);
    font-size: 1.06rem;
    max-width: 48ch;
  }
  .about__copy strong {
    color: var(--ink);
    font-weight: 600;
  }
  .about__list {
    list-style: none;
    padding: 0;
    margin: 1.6rem 0 2rem;
    display: grid;
    gap: 0.8rem;
  }
  .about__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-size: 1rem;
  }
  .tick {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--accent-wash);
    color: var(--accent-deep);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    margin-top: 2px;
  }
</style>
