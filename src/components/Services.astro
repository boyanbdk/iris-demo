---
import { clinic } from '../config/clinic';
import ServiceIcon from './ServiceIcon.astro';
---

<section
  class="section services"
  id="services"
  style={`--services-backdrop: url('${clinic.media.serviceBackdrop}')`}
>
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Какво предлагаме</span>
      <h2>Пълна грижа за зъбите на едно място</h2>
      <p>
        От редовна профилактика до сложни възстановявания — с модерна апаратура и внимателен,
        индивидуален подход към всеки пациент.
      </p>
    </div>

    <div class="svc-grid">
      {
        clinic.services.map((s) => (
          <article class="svc-card reveal">
            <ServiceIcon icon={s.icon} />
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    position: relative;
    isolation: isolate;
    background: var(--bg);
  }
  .services::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(rgba(245, 242, 236, 0.9), rgba(245, 242, 236, 0.96)),
      var(--services-backdrop) center / cover;
  }
  .svc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.1rem;
  }
  @media (min-width: 620px) {
    .svc-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .svc-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .svc-card {
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(8px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.7rem 1.6rem 1.8rem;
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .svc-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--line-strong);
  }
  .svc-card h3 {
    font-family: var(--font-serif);
    font-size: 1.32rem;
    margin-top: 1rem;
  }
  .svc-card p {
    margin-top: 0.6rem;
    font-size: 0.98rem;
    color: var(--ink-soft);
  }
  @media (max-width: 619px) {
    .services::before {
      background:
        linear-gradient(rgba(245, 242, 236, 0.96), rgba(245, 242, 236, 0.98)),
        var(--services-backdrop) center / cover;
    }
    .svc-card {
      backdrop-filter: none;
    }
  }
</style>
