---
import { clinic } from '../config/clinic';
---

<section class="section clinic-gallery" aria-labelledby="clinic-gallery-title">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Вътре в Ирис</span>
      <h2 id="clinic-gallery-title">Пространство, създадено за спокойствие</h2>
      <p>Измислени изображения на една последователна демонстрационна клиника.</p>
    </div>

    <div
      class="clinic-gallery__carousel reveal"
      data-gallery-carousel
      role="region"
      aria-roledescription="галерия"
      aria-label="Интериор и грижа в демонстрационната клиника Ирис"
    >
      <div class="clinic-gallery__track" data-gallery-track tabindex="0">
        {
          clinic.gallery.map((item, index) => (
            <figure
              class="clinic-gallery__slide"
              data-gallery-slide
              role="group"
              aria-roledescription="изображение"
              aria-label={`${index + 1} от ${clinic.gallery.length}`}
              aria-current={index === 0 ? 'true' : undefined}
            >
              <div class="clinic-gallery__media">
                <img
                  src={item.src}
                  alt={item.alt}
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                />
              </div>
              <figcaption>{item.caption}</figcaption>
            </figure>
          ))
        }
      </div>

      <div class="clinic-gallery__toolbar">
        <p class="clinic-gallery__hint">Плъзнете галерията или използвайте стрелките.</p>
        <div class="clinic-gallery__navigation" aria-label="Управление на галерията">
          <button
            class="clinic-gallery__control"
            type="button"
            data-gallery-previous
            aria-label="Предишно изображение"
          >
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true">
              <path d="m15 5-7 7 7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <p
            class="clinic-gallery__counter"
            data-gallery-counter
            aria-live="polite"
            aria-atomic="true"
            aria-label={`1 от ${clinic.gallery.length}`}
          >
            <span aria-hidden="true">
              <span data-gallery-current>1</span> / <span>{clinic.gallery.length}</span>
            </span>
          </p>
          <button
            class="clinic-gallery__control"
            type="button"
            data-gallery-next
            aria-label="Следващо изображение"
          >
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true">
              <path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const carousels = document.querySelectorAll<HTMLElement>('[data-gallery-carousel]');

  carousels.forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('[data-gallery-track]');
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-gallery-slide]'));
    const previousButton = carousel.querySelector<HTMLButtonElement>('[data-gallery-previous]');
    const nextButton = carousel.querySelector<HTMLButtonElement>('[data-gallery-next]');
    const counter = carousel.querySelector<HTMLElement>('[data-gallery-counter]');
    const current = carousel.querySelector<HTMLElement>('[data-gallery-current]');

    if (!track || slides.length === 0 || !previousButton || !nextButton || !counter || !current) return;

    let selectedIndex = 0;
    let programmaticScroll = false;
    let scrollFrame = 0;
    let scrollSettleTimer = 0;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const updateSelection = (index: number) => {
      selectedIndex = Math.max(0, Math.min(index, slides.length - 1));
      current.textContent = String(selectedIndex + 1);
      counter.setAttribute('aria-label', `${selectedIndex + 1} от ${slides.length}`);

      slides.forEach((slide, slideIndex) => {
        if (slideIndex === selectedIndex) slide.setAttribute('aria-current', 'true');
        else slide.removeAttribute('aria-current');
      });
    };

    const nearestSlideIndex = () => {
      let nearestIndex = 0;
      let nearestDistance = Number.POSITIVE_INFINITY;

      slides.forEach((slide, index) => {
        const distance = Math.abs(slide.offsetLeft - track.scrollLeft);
        if (distance < nearestDistance) {
          nearestDistance = distance;
          nearestIndex = index;
        }
      });

      return nearestIndex;
    };

    const scrollToSlide = (index: number) => {
      const wrappedIndex = (index + slides.length) % slides.length;
      const slide = slides[wrappedIndex];
      const wrapsAround = Math.abs(wrappedIndex - selectedIndex) > 1;

      programmaticScroll = true;
      window.clearTimeout(scrollSettleTimer);
      updateSelection(wrappedIndex);
      track.scrollTo({
        left: slide.offsetLeft,
        behavior: reduceMotion.matches || wrapsAround ? 'auto' : 'smooth',
      });
    };

    previousButton.addEventListener('click', () => scrollToSlide(selectedIndex - 1));
    nextButton.addEventListener('click', () => scrollToSlide(selectedIndex + 1));

    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        scrollToSlide(selectedIndex - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        scrollToSlide(selectedIndex + 1);
      }
    });

    track.addEventListener(
      'scroll',
      () => {
        window.cancelAnimationFrame(scrollFrame);
        window.clearTimeout(scrollSettleTimer);

        if (!programmaticScroll) {
          scrollFrame = window.requestAnimationFrame(() => updateSelection(nearestSlideIndex()));
        }

        scrollSettleTimer = window.setTimeout(() => {
          programmaticScroll = false;
          updateSelection(nearestSlideIndex());
        }, 160);
      },
      { passive: true },
    );

    window.addEventListener('resize', () => {
      track.scrollTo({ left: slides[selectedIndex].offsetLeft, behavior: 'auto' });
    });
  });
</script>

<style>
  .clinic-gallery {
    background: var(--ink);
    color: #f2f1ec;
  }
  .clinic-gallery :global(.section-head h2),
  .clinic-gallery :global(.eyebrow) {
    color: #f2f1ec;
  }
  .clinic-gallery :global(.section-head p) {
    color: rgba(242, 241, 236, 0.72);
  }
  .clinic-gallery__carousel {
    overflow: hidden;
    border-radius: var(--radius);
    background: #101713;
  }
  .clinic-gallery__track {
    display: flex;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .clinic-gallery__track::-webkit-scrollbar {
    display: none;
  }
  .clinic-gallery__track:focus-visible {
    outline: 3px solid #fff;
    outline-offset: -6px;
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .clinic-gallery__slide {
    display: grid;
    flex: 0 0 100%;
    min-width: 0;
    grid-template-rows: minmax(0, 1fr) auto;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .clinic-gallery__media {
    display: flex;
    aspect-ratio: 3 / 2;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #0b100e;
  }
  .clinic-gallery__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .clinic-gallery__slide figcaption {
    min-height: 74px;
    padding: 1.25rem clamp(1.25rem, 3vw, 2rem);
    color: #fff;
    font-size: clamp(0.95rem, 2vw, 1.08rem);
    line-height: 1.5;
  }
  .clinic-gallery__toolbar {
    display: flex;
    min-height: 72px;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.75rem clamp(1rem, 3vw, 1.5rem);
    padding-inline-end: clamp(5rem, 9vw, 6rem);
    border-top: 1px solid rgba(255, 255, 255, 0.11);
    background: #17201d;
  }
  .clinic-gallery__hint {
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.86rem;
  }
  .clinic-gallery__navigation {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.85rem;
  }
  .clinic-gallery__control {
    display: inline-flex;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    background: transparent;
    color: #fff;
    cursor: pointer;
    transition: background 180ms ease-out, border-color 180ms ease-out;
  }
  .clinic-gallery__control:hover {
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.08);
  }
  .clinic-gallery__counter {
    min-width: 4.1rem;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
    text-align: center;
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .clinic-gallery__media {
      aspect-ratio: 4 / 3;
    }
    .clinic-gallery__slide figcaption {
      min-height: 92px;
      padding: 1rem 1.1rem;
    }
    .clinic-gallery__toolbar {
      min-height: 0;
      flex-direction: column;
      gap: 0.6rem;
      padding-block: 0.8rem;
    }
    .clinic-gallery__hint {
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .clinic-gallery__control {
      transition: none;
    }
  }
</style>
