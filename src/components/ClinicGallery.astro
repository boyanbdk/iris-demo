---
import { clinic } from '../config/clinic';

const firstGalleryItem = clinic.gallery[0];
const visibleGalleryItems = clinic.gallery.slice(0, 3);
const fallbackGalleryItems = clinic.gallery.slice(3);
const galleryItemsJson = JSON.stringify(clinic.gallery).replaceAll('<', '\\u003c');
---

<section class="section clinic-gallery" aria-labelledby="clinic-gallery-title">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Вътре в Ирис</span>
      <h2 id="clinic-gallery-title">Пространство, създадено за спокойствие</h2>
      <p>Измислени изображения на една последователна демонстрационна клиника.</p>
    </div>
    <div class="clinic-gallery__grid">
      {
        visibleGalleryItems.map((item, index) => (
          <figure
            class:list={[
              'clinic-gallery__item',
              'reveal',
              'reveal-scale',
              `clinic-gallery__item--${item.layout}`,
            ]}
          >
            <button
              class="clinic-gallery__trigger"
              type="button"
              aria-label={`Отворете изображението: ${item.caption}`}
              data-gallery-trigger
              data-gallery-index={index}
              data-gallery-src={item.src}
              data-gallery-alt={item.alt}
              data-gallery-caption={item.caption}
              data-gallery-width={item.width}
              data-gallery-height={item.height}
            >
              <img
                src={item.src}
                alt={item.alt}
                width={item.width}
                height={item.height}
                loading="lazy"
              />
              <span class="clinic-gallery__expand" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
                  <path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <span>Отворете</span>
              </span>
            </button>
            <figcaption>{item.caption}</figcaption>
          </figure>
        ))
      }
    </div>
    <noscript>
      <div class="clinic-gallery__grid clinic-gallery__grid--fallback">
        {
          fallbackGalleryItems.map((item) => (
            <figure
              class:list={[
                'clinic-gallery__item',
                `clinic-gallery__item--${item.layout}`,
              ]}
            >
              <img
                class="clinic-gallery__fallback-image"
                src={item.src}
                alt={item.alt}
                width={item.width}
                height={item.height}
                loading="lazy"
              />
              <figcaption>{item.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </noscript>
  </div>

  <script
    is:inline
    type="application/json"
    data-gallery-items
    set:html={galleryItemsJson}
  ></script>

  <dialog
    class="clinic-gallery__dialog"
    data-gallery-dialog
    aria-labelledby="gallery-dialog-caption"
  >
    <div class="clinic-gallery__dialog-panel" data-gallery-panel>
      <button
        class="clinic-gallery__dialog-close"
        type="button"
        data-gallery-close
        aria-label="Затворете изображението"
        autofocus
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
          <path d="m5 5 14 14M19 5 5 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
      </button>

      <div class="clinic-gallery__dialog-viewport" data-gallery-viewport>
        <img
          class="clinic-gallery__dialog-image"
          data-gallery-image
          alt=""
          width={firstGalleryItem.width}
          height={firstGalleryItem.height}
        />
      </div>

      <div class="clinic-gallery__dialog-footer">
        <button
          class="clinic-gallery__dialog-control clinic-gallery__dialog-control--previous"
          type="button"
          data-gallery-previous
          aria-label="Предишно изображение"
        >
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true">
            <path d="m15 5-7 7 7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <p class="clinic-gallery__dialog-caption" id="gallery-dialog-caption" data-gallery-caption></p>
        <p class="clinic-gallery__dialog-counter" data-gallery-counter aria-live="polite" aria-atomic="true"></p>
        <button
          class="clinic-gallery__dialog-control clinic-gallery__dialog-control--next"
          type="button"
          data-gallery-next
          aria-label="Следващо изображение"
        >
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true">
            <path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </dialog>
</section>

<script>
  interface GalleryItem {
    src: string;
    alt: string;
    caption: string;
    width: number;
    height: number;
  }

  const dialog = document.querySelector<HTMLDialogElement>('[data-gallery-dialog]');
  const triggers = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-gallery-trigger]'),
  );
  const galleryItemsElement = document.querySelector<HTMLScriptElement>('[data-gallery-items]');

  if (dialog && triggers.length > 0) {
    const dialogImage = dialog.querySelector<HTMLImageElement>('[data-gallery-image]');
    const dialogCaption = dialog.querySelector<HTMLElement>('[data-gallery-caption]');
    const dialogCounter = dialog.querySelector<HTMLElement>('[data-gallery-counter]');
    const closeButton = dialog.querySelector<HTMLButtonElement>('[data-gallery-close]');
    const previousButton = dialog.querySelector<HTMLButtonElement>('[data-gallery-previous]');
    const nextButton = dialog.querySelector<HTMLButtonElement>('[data-gallery-next]');
    const viewport = dialog.querySelector<HTMLElement>('[data-gallery-viewport]');

    const items = JSON.parse(galleryItemsElement?.textContent ?? '[]') as GalleryItem[];

    if (
      dialogImage &&
      dialogCaption &&
      dialogCounter &&
      closeButton &&
      previousButton &&
      nextButton &&
      viewport
    ) {
      let selectedIndex = 0;
      let openingTrigger: HTMLButtonElement | null = null;
      let touchStart: { identifier: number; x: number; y: number } | null = null;
      const preloadedSources = new Set<string>();

      const savedStyles = {
        htmlOverflow: '',
        bodyOverflow: '',
        bodyPaddingRight: '',
      };

      const preloadAdjacent = () => {
        const adjacentIndexes = [
          (selectedIndex - 1 + items.length) % items.length,
          (selectedIndex + 1) % items.length,
        ];

        adjacentIndexes.forEach((index) => {
          const source = items[index].src;
          if (source === items[selectedIndex].src || preloadedSources.has(source)) return;

          const image = new Image();
          image.src = source;
          preloadedSources.add(source);
        });
      };

      const renderSelection = (index: number) => {
        selectedIndex = (index + items.length) % items.length;
        const item = items[selectedIndex];

        dialogImage.src = item.src;
        dialogImage.alt = item.alt;
        dialogImage.width = item.width;
        dialogImage.height = item.height;
        dialogCaption.textContent = item.caption;
        dialogCounter.textContent = `${selectedIndex + 1} от ${items.length}`;
        preloadAdjacent();
      };

      const lockBackgroundScroll = () => {
        const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
        savedStyles.htmlOverflow = document.documentElement.style.overflow;
        savedStyles.bodyOverflow = document.body.style.overflow;
        savedStyles.bodyPaddingRight = document.body.style.paddingRight;

        const currentPadding = Number.parseFloat(getComputedStyle(document.body).paddingRight) || 0;
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
        if (scrollbarWidth > 0) {
          document.body.style.paddingRight = `${currentPadding + scrollbarWidth}px`;
        }
      };

      const unlockBackgroundScroll = () => {
        document.documentElement.style.overflow = savedStyles.htmlOverflow;
        document.body.style.overflow = savedStyles.bodyOverflow;
        document.body.style.paddingRight = savedStyles.bodyPaddingRight;
      };

      const showPrevious = () => renderSelection(selectedIndex - 1);
      const showNext = () => renderSelection(selectedIndex + 1);

      triggers.forEach((trigger, index) => {
        trigger.addEventListener('click', () => {
          openingTrigger = trigger;
          renderSelection(index);
          lockBackgroundScroll();
          dialog.showModal();
          closeButton.focus({ preventScroll: true });
        });
      });

      closeButton.addEventListener('click', () => dialog.close());
      previousButton.addEventListener('click', showPrevious);
      nextButton.addEventListener('click', showNext);

      dialog.addEventListener('click', (event) => {
        if (event.target === dialog || event.target === viewport) dialog.close();
      });

      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          event.preventDefault();
          dialog.close();
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          showPrevious();
        } else if (event.key === 'ArrowRight') {
          event.preventDefault();
          showNext();
        }
      });

      dialog.addEventListener('close', () => {
        unlockBackgroundScroll();
        openingTrigger?.focus({ preventScroll: true });
        openingTrigger = null;
      });

      viewport.addEventListener(
        'touchstart',
        (event) => {
          if (event.touches.length !== 1) {
            touchStart = null;
            return;
          }

          const touch = event.touches[0];
          touchStart = touch
            ? { identifier: touch.identifier, x: touch.clientX, y: touch.clientY }
            : null;
        },
        { passive: true },
      );

      viewport.addEventListener(
        'touchmove',
        (event) => {
          if (
            touchStart &&
            (event.touches.length !== 1 ||
              event.touches[0]?.identifier !== touchStart.identifier)
          ) {
            touchStart = null;
          }
        },
        { passive: true },
      );

      viewport.addEventListener(
        'touchend',
        (event) => {
          if (!touchStart) return;
          const touch = Array.from(event.changedTouches).find(
            (changedTouch) => changedTouch.identifier === touchStart?.identifier,
          );
          if (!touch) {
            touchStart = null;
            return;
          }

          const deltaX = touch.clientX - touchStart.x;
          const deltaY = touch.clientY - touchStart.y;
          touchStart = null;

          if (Math.abs(deltaX) < 56 || Math.abs(deltaX) < Math.abs(deltaY) * 1.25) return;
          if (deltaX > 0) showPrevious();
          else showNext();
        },
        { passive: true },
      );

      viewport.addEventListener('touchcancel', () => {
        touchStart = null;
      });
    }
  }
</script>

<style>
  .clinic-gallery {
    background: var(--ink);
    color: #f2f1ec;
  }
  .clinic-gallery :global(.section-head h2),
  .clinic-gallery :global(.eyebrow) {
    color: #f2f1ec;
  }
  .clinic-gallery :global(.section-head p) {
    color: rgba(242, 241, 236, 0.72);
  }
  .clinic-gallery__grid {
    display: grid;
    gap: 1rem;
  }
  .clinic-gallery__item {
    position: relative;
    overflow: hidden;
    min-height: 330px;
    border-radius: var(--radius);
  }
  .clinic-gallery__trigger {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
    font: inherit;
    cursor: zoom-in;
  }
  .clinic-gallery__trigger:focus-visible {
    outline: 3px solid #fff;
    outline-offset: -6px;
  }
  .clinic-gallery__trigger img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .clinic-gallery__fallback-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .clinic-gallery__grid--fallback {
    margin-top: 1rem;
  }
  .clinic-gallery__trigger:hover img,
  .clinic-gallery__trigger:focus-visible img {
    transform: scale(1.025);
  }
  .clinic-gallery__expand {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 999px;
    background: rgba(23, 32, 29, 0.76);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.16);
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1;
    backdrop-filter: blur(8px);
  }
  .clinic-gallery__item figcaption {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    left: 0.9rem;
    padding: 0.8rem 0.9rem;
    border-radius: var(--radius-sm);
    background: rgba(23, 32, 29, 0.78);
    color: #fff;
    font-size: 0.9rem;
    pointer-events: none;
    backdrop-filter: blur(8px);
  }

  .clinic-gallery__dialog {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: auto;
    padding: clamp(1rem, 4dvh, 2.5rem) clamp(1rem, 3vw, 2.5rem);
    border: 0;
    background: transparent;
    color: #fff;
    overflow: hidden;
  }
  .clinic-gallery__dialog::backdrop {
    background: rgba(7, 12, 10, 0.9);
    backdrop-filter: blur(5px);
  }
  .clinic-gallery__dialog-panel {
    position: relative;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    width: min(100%, 1100px);
    height: min(100%, 850px);
    margin: auto;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: var(--radius);
    background: #101713;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.38);
  }
  .clinic-gallery__dialog[open] .clinic-gallery__dialog-panel {
    animation: gallery-dialog-in 260ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .clinic-gallery__dialog-viewport {
    display: flex;
    min-width: 0;
    min-height: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: clamp(1rem, 3vw, 2.5rem);
    touch-action: pan-y pinch-zoom;
  }
  .clinic-gallery__dialog-image {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    object-fit: contain;
  }
  .clinic-gallery__dialog-close,
  .clinic-gallery__dialog-control {
    display: inline-flex;
    width: 48px;
    min-width: 44px;
    height: 48px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    background: rgba(23, 32, 29, 0.86);
    color: #fff;
    cursor: pointer;
  }
  .clinic-gallery__dialog-close:hover,
  .clinic-gallery__dialog-control:hover {
    background: #27332f;
  }
  .clinic-gallery__dialog-close {
    position: absolute;
    z-index: 2;
    top: max(0.75rem, env(safe-area-inset-top));
    right: max(0.75rem, env(safe-area-inset-right));
  }
  .clinic-gallery__dialog-footer {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto 48px;
    gap: 0.85rem;
    align-items: center;
    min-width: 0;
    padding: 1rem clamp(1rem, 3vw, 1.5rem);
    padding-bottom: max(1rem, env(safe-area-inset-bottom));
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    background: #17201d;
  }
  .clinic-gallery__dialog-caption {
    min-width: 0;
    color: #fff;
    font-size: clamp(0.9rem, 2vw, 1rem);
    line-height: 1.45;
  }
  .clinic-gallery__dialog-counter {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @keyframes gallery-dialog-in {
    from {
      opacity: 0;
      transform: scale(0.975);
    }
  }

  @media (min-width: 800px) {
    .clinic-gallery__grid {
      grid-template-columns: 1.35fr 0.8fr 0.8fr;
    }
    .clinic-gallery__item {
      min-height: 520px;
    }
  }

  @media (max-width: 600px) {
    .clinic-gallery__dialog {
      padding: 0;
    }
    .clinic-gallery__dialog-panel {
      width: 100%;
      height: 100%;
      border: 0;
      border-radius: 0;
    }
    .clinic-gallery__dialog-viewport {
      padding: 3.75rem 0.75rem 0.75rem;
    }
    .clinic-gallery__dialog-footer {
      grid-template-columns: 48px minmax(0, 1fr) 48px;
      gap: 0.75rem;
      padding-inline: max(0.75rem, env(safe-area-inset-left));
    }
    .clinic-gallery__dialog-control--previous {
      grid-column: 1;
      grid-row: 1 / span 2;
    }
    .clinic-gallery__dialog-caption {
      grid-column: 2;
      grid-row: 1;
    }
    .clinic-gallery__dialog-counter {
      grid-column: 2;
      grid-row: 2;
    }
    .clinic-gallery__dialog-control--next {
      grid-column: 3;
      grid-row: 1 / span 2;
    }
  }

  @media (max-width: 420px) {
    .clinic-gallery__expand span:last-child {
      display: none;
    }
    .clinic-gallery__expand {
      width: 44px;
      justify-content: center;
      padding-inline: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .clinic-gallery__trigger img {
      transition: none;
    }
    .clinic-gallery__trigger:hover img,
    .clinic-gallery__trigger:focus-visible img {
      transform: none;
    }
    .clinic-gallery__dialog[open] .clinic-gallery__dialog-panel {
      animation: none;
    }
  }
</style>
