---
import { clinic } from '../config/clinic';
import ClinicMap from './ClinicMap.astro';
---

<section class="section contact" id="contact">
  <div class="wrap contact__grid">
    <div class="contact__info reveal">
      <span class="eyebrow">Контакти</span>
      <h2>Заповядайте при нас</h2>
      <p class="contact__lead">
        Адресът, часовете и маркерът са измислени демонстрационни данни. Картата показва как реална
        клиника може да насочи пациента, но този сайт не приема записвания.
      </p>

      <dl class="contact__rows">
        <div class="contact__row">
          <dt>Адрес</dt>
          <dd>
            {clinic.address.street}<br />
            {clinic.address.district}, {clinic.address.city}
          </dd>
        </div>
        <div class="contact__row">
          <dt>Телефон</dt>
          <dd>Демонстрация — без реален телефон</dd>
        </div>
        <div class="contact__row">
          <dt>Работно време</dt>
          <dd>
            {
              clinic.hours.map((h) => (
                <span class="contact__hours">
                  <span>{h.day}</span>
                  <span>{h.time}</span>
                </span>
              ))
            }
          </dd>
        </div>
      </dl>

      <div class="contact__cta">
        <a class="btn btn--primary" href="https://autosilas.com/offers/">Искате такъв сайт?</a>
      </div>
    </div>

    <ClinicMap />
  </div>
</section>

<style>
  .contact {
    background: var(--bg-deep);
  }
  .contact__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: stretch;
  }
  @media (min-width: 900px) {
    .contact__grid {
      grid-template-columns: 1fr 1.1fr;
    }
  }
  .contact__info h2 {
    font-size: clamp(2rem, 4.2vw, 3rem);
    margin-top: 0.9rem;
  }
  .contact__lead {
    margin-top: 1.1rem;
    color: var(--ink-soft);
    max-width: 44ch;
  }
  .contact__rows {
    margin: 2rem 0 0;
    display: grid;
    gap: 1.3rem;
  }
  .contact__row dt {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .contact__row dd {
    margin: 0.35rem 0 0;
    font-size: 1.05rem;
  }
  .contact__row a {
    color: var(--accent-deep);
    font-weight: 600;
  }
  .contact__hours {
    display: flex;
    justify-content: space-between;
    max-width: 340px;
    gap: 1rem;
  }
  .contact__hours span:last-child {
    color: var(--ink-soft);
  }
  .contact__cta {
    margin-top: 2.2rem;
  }
</style>
